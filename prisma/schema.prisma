// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  // provider = "prisma-client"
  // output   = "../generated/prisma"
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  email              String              @unique
  password           String?
  practiceName       String
  avatar             String?
  phoneNumber        String?
  role               UserAccountType     @default(HOSPITAL)
  provider           AuthProvider        @default(LOCAL)
  pharmacyProfile    PharmacyProfile?
  providerId         String?
  isEmailVerified    Boolean             @default(false)
  refreshToken       String?
  userSettings       UserSetting[]
  passwordResets     PasswordReset[]
  verificationTokens VerificationToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserAccountType {
  ADMIN
  HOSPITAL
  PHARMACY
}


model UserSetting {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  userId          String  @db.ObjectId
  notificationsOn Boolean @default(true)
  smsEnabled      Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model PasswordReset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Upload
model Upload {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  mimeType  String
  provider  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// Pharmacy schema
model PharmacyProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  address     String
  cacNumber   String?
  bio         String?
  pcnLicenseUrl        String?
  businessRegDocUrl    String?
  hmoAffiliations      String[]
  isSetupComplete      Boolean  @default(false)

  user              User               @relation(fields: [userId], references: [id])
  workingSchedules  WorkingSchedule[]
  branches          PharmacyBranch[]
  drugCategories    PharmacyDrugCategory[]

  pharmacists      Pharmacist[]
  pharmacistInvites PharmacistInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkingSchedule {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId String   @db.ObjectId
  day        DayOfWeek
  fromTime   String   // e.g. "9:00 AM"
  toTime     String   // e.g. "4:00 PM"
  isActive   Boolean  @default(true)

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id])
}

model PharmacyBranch {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId       String   @db.ObjectId
  branchAddress    String
  emergencyPhone   String?
  servicesOffered  String[]

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PharmacyDrugCategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId String   @db.ObjectId
  name       String   // e.g. "Antiretrovirals (ARV)"
  drugs      String[] // e.g. ["Remdesivir", "Tenofovir"]

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Pharmacist Schema

model Pharmacist {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId       String            @db.ObjectId
  firstName        String?
  lastName         String?
  email            String
  phoneNumber      String?
  workEmail        String?
  licenseNumber    String?
  employeeNumber   String?
  languagesSpoken  String[]
  bio              String?
  avatar           String?
  isActive         Boolean           @default(true)
  status           PharmacistStatus  @default(ACTIVE)

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PharmacistInvite {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId     String        @db.ObjectId
  email          String
  employeeNumber String?
  status         InviteStatus  @default(PENDING)
  expiresAt      DateTime
  token          String        @unique

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PharmacistStatus {
  ACTIVE
  DISABLED
  REMOVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}